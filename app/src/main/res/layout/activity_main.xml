<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_marginTop="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCE4EC"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tv_titre_bbf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DOUANE TEMPORELLE"
        android:textColor="#AD1457"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/et_nom_bbf"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:autofillHints=""
        android:hint="Nom complet"
        android:inputType="text"
        android:minHeight="48dp"
        android:textColorHint="#546E7A"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_titre_bbf"
        tools:ignore="VisualLintTextFieldSize" />

    <EditText
        android:id="@+id/et_naissance_bbf"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:autofillHints=""
        android:hint="Année  naissance"
        android:inputType="number"
        android:minHeight="48dp"
        android:textColorHint="#546E7A"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_nom_bbf"
        tools:ignore="VisualLintTextFieldSize" />

    <EditText
        android:id="@+id/et_destination_bbf"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:autofillHints=""
        android:hint="Année  destination"
        android:inputType="number"
        android:minHeight="48dp"
        android:textColorHint="#546E7A"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_naissance_bbf"
        tools:ignore="VisualLintTextFieldSize" />

    <RadioGroup
        android:id="@+id/rg_motif_bbf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/et_destination_bbf"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <RadioButton
            android:id="@+id/rb_tourisme_bbf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tourisme"
            android:textSize="16sp"/>

        <RadioButton
            android:id="@+id/rb_modification_bbf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modification du passé"
            android:textSize="16sp"/>

        <RadioButton
            android:id="@+id/rb_fuite_bbf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fuite"
            android:textSize="16sp"/>

    </RadioGroup>

    <Button
        android:id="@+id/btn_inspecter_bbf"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:text="Inspecter le profil"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#AD1457"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rg_motif_bbf"
        tools:ignore="VisualLintButtonSize" />

</androidx.constraintlayout.widget.ConstraintLayout>