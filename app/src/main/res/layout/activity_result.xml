<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_result_bbf"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FCE4EC">

    <TextView
        android:id="@+id/tv_verdict_bbf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verdict du voyage"
        android:textColor="#6A1B4D"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <Button
        android:id="@+id/btn_nouveau_voyageur_bbf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#AD1457"
        android:text="Nouveau voyageur"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>

</LinearLayout>